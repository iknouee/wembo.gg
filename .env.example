# ===========================================
# Wembo Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ----- Discord Bot -----
BOT_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_client_id
GUILD_ID=your_discord_server_id

# ----- Discord OAuth2 (for website login) -----
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ----- Database -----
DATABASE_URL=postgresql://user:password@localhost:5432/wembo

# ----- Authentication -----
AUTH_SECRET=generate_a_random_secret_here

# ----- AI -----
AI_API_KEY=your_ai_api_key

# ----- Application -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Production -----
# When deploying to Vercel, set NEXT_PUBLIC_APP_URL to https://wembo.xyz
